# HakiOS fragment: the Qualcomm SM8150 family ("Snapdragon 855 / 855+", "msmnile") -- what is true of the SoC, whatever phone it is in.
# Eight Kryo 485 cores with the Prime core at index 7; SMEM is at 0x86000000 on SM8150 (vs 0x80900000 on SC7280).
CONFIG_SOC="sm8150"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_SOCINFO=y
CONFIG_SOC_SMEM=0x86000000
CONFIG_THERMAL=y
# the drivers of this SoC family in the common tree
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_UFS=y
CONFIG_HAKIOS_BATTGUARD=y
